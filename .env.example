# Скопируйте в `.env`. Для deploy_bot: см. `secrets/deploy_bot/profiles/s21agent.env`.

GIGACHAT_API_KEY=your_api_key

# Rocket.Chat (нужен только при rocket_search=true в /ask)
ROCKETCHAT_BASE_URL=https://rocketchat-student.21-school.ru
ROCKETCHAT_USER=username@student.21-school.ru
ROCKETCHAT_PASSWORD=password

ASK_TIMEOUT_S=300

# Пайплайн deep-режима (rocket_search + deep_search); fast берёт урезанный профиль из кода
# RC_MAX_SUBQUERIES=2
# RC_ROOMS_PER_SUBQUERY=6
# RC_QUERIES_PER_SUBQUERY=2
# RC_SEARCH_COUNT=20
# RC_RERANK_TOP_N=8
# RC_RERANK_MAX_CANDIDATES=15
# RC_RERANK_MODE=hybrid
# RC_THREAD_EXPAND_TOP=2
# RC_THREAD_MESSAGES_COUNT=30
# RC_HTTP_CONCURRENCY=12
# RC_SEARCH_TIMEOUT_S=20
# RC_THREAD_TIMEOUT_S=15
# RC_TIMEOUT_READ_S=60

# RAG (дефолт: FAISS top-8 без CE rerank)
# RAG_TOPK=8
# RAG_RERANK_TOP=0

# CPU threads для torch/BLAS (default 2)
# OMP_NUM_THREADS=2
# MKL_NUM_THREADS=2
# TORCH_NUM_THREADS=2

# Часовой пояс для «сегодня» в промпте и RC-поиске (default Europe/Moscow)
# S21_AGENT_TZ=Europe/Moscow

# Rocket.Chat: max символов текста сообщения в EVIDENCE (0 = без лимита)
# RC_EVIDENCE_MSG_MAX_CHARS=2500

HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=0

AGENT_EDGE_PORT=8000
TLS_DISABLED=false
AGENT_APP_HOST=s21_agent
AGENT_APP_PORT=8000
