# Скопируйте в `.env`. Для deploy_bot: см. `secrets/deploy_bot/profiles/s21agent.env`.

GIGACHAT_API_KEY=your_api_key

# Rocket.Chat (обязательно для rocket-search, см. src/rc/config.py)
ROCKETCHAT_BASE_URL=https://rocketchat-student.21-school.ru
ROCKETCHAT_USER=username@student.21-school.ru
ROCKETCHAT_PASSWORD=password

ROCKETCHAT_SEARCH_COUNT=50
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
MAX_PROJECT_SUGGESTIONS=5
PROJECT_CONFIRMATION_REQUIRED=true
ASK_TIMEOUT_S=300

# Опционально: таймауты и пайплайн (см. src/rc/config.py)
# RC_TIMEOUT_CONNECT_S=5
# RC_RERANKER_MODEL=qilowoq/bge-reranker-v2-m3-en-ru

# uvicorn (main.py); в проде обычно UVICORN_RELOAD=0
HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=0

# docker-compose.agent.yml (edge nginx)
AGENT_EDGE_PORT=8000
TLS_DISABLED=false
AGENT_APP_HOST=s21_agent
AGENT_APP_PORT=8000

# Опционально: TLS для edge (base64 PEM) или TLS_DISABLED=true
# TLS_CERT_PEM_BASE64=
# TLS_KEY_PEM_BASE64=
